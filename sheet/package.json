{
  "name": "orf-sheet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "cd .. && npm run bundle-content",
    "dev": "vite",
    "prebuild": "cd .. && npm run bundle-content",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test --project desktop --project phone",
    "e2e:update": "playwright test --project desktop --project phone --update-snapshots",
    "e2e:report": "playwright show-report",
    "demo:record": "playwright test --project demo && node scripts/finish-demo.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "preact": "^10.25.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@preact/preset-vite": "^2.9.0",
    "@testing-library/preact": "^3.2.4",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
